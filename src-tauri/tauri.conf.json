{
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"copyright": "",
		"category": "Entertainment",
		"shortDescription": "A media library and BitTorrent player for Movies and Series",
		"longDescription": "Surfex keeps track of what you watch and plays torrents in a native player, on the desktop, mobile and Android TV. It hosts no content and ships with no sources configured.",
		"macOS": {},
		"linux": {
			"deb": {
				"depends": ["mpv"]
			},
			"rpm": {
				"depends": ["mpv"]
			}
		}
	},
	"build": {
		"beforeBuildCommand": "bun run generate",
		"beforeBundleCommand": "bun scripts/build/macos/bundle-dylib.ts",
		"frontendDist": "../.output/public",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:3000"
