	"productName": "Surfex",
	"version": "0.4.0",
	"identifier": "com.surfex.app",
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFOThGN0RFQTA2RUE5N0IKUldSN3FXNmczdmVZYnRoakMxNWVRR3pTSFMvbnpVQjFVbEdwN3dINVR6cFl3VmpVSlVhdlR3OHQK",
			"endpoints": [
				"https://github.com/smartworldarafath/Surfex---Movies-and-Series/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		},
		"shell": {
			"open": "(?:(?:https?|file)://.+|mailto:.+|tel:.+|/.+|[A-Za-z]:[\\\\/].+|\\\\\\\\.+)"
